{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["on sunday"]
    }
  },
  "packageRules": [
    {
      "description": "Schedule updates for all packages on Sundays",
      "matchPackageNames": ["**"],
      "schedule": ["on sunday"]
    },
    {
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "matchManagers": ["haskell-cabal"],
      "matchPackageNames": ["base"],
      "enabled": false,
      "description": "The base bound tracks the GHC versions in tested-with, not Hackage releases, so widening it is a deliberate compiler-support decision."
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix"
    }
  ],
  "prHourlyLimit": 5
}
